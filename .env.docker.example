# Docker Compose deployment settings. Copy to .env and fill in the secrets.
POSTGRES_DB=seed_hotel
POSTGRES_USER=seed_hotel
POSTGRES_PASSWORD=replace_with_a_long_random_database_password

# Get these from your Clerk and Groq dashboards.
CLERK_PUBLISHABLE_KEY=pk_test_replace_me
CLERK_SECRET_KEY=sk_test_replace_me
GROQ_API_KEY=replace_with_your_groq_api_key

# Generate a strong random value, for example: openssl rand -hex 32
SESSION_SECRET=replace_with_a_long_random_secret

# Public HTTP port for the site (set to 80 or 443 behind a reverse proxy).
WEB_PORT=8080
